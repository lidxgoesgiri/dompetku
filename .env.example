NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Required for database operations and the health check.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dompetku
DB_USER=postgres
DB_PASSWORD=

# Required for authentication. Use a random secret of at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Separate database used when NODE_ENV=test or Knex --env test is selected.
TEST_DB_NAME=dompetku_test
